{
  "name": "geo-platform",
  "version": "1.0.0",
  "description": "GEO Platform - AI搜索优化工作台",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
